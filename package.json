{
  "name": "devtools-unlock",
  "version": "1.2.0",
  "description": "Open-source unlock for sites that block DevTools (e.g. disable-devtool).",
  "private": true,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webLiang/devtools-unlock"
  },
  "scripts": {
    "build:iife": "node scripts/build-iife.mjs",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:all": "run-s build build:firefox",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "pnpm build:hmr && (run-p wss build:watch)",
    "dev:firefox": "pnpm build:hmr && (run-p wss build:firefox:watch)",
    "zip": "pnpm build:zip",
    "build:zip": "pnpm build && bash scripts/pack.sh",
    "build:firefox:zip": "pnpm build:firefox && bash scripts/pack.sh --firefox",
    "pack:firefox:sources": "bash scripts/pack-firefox-sources.sh",
    "build:crx": "pnpm build && node utils/create-crx.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "node scripts/assert-dist.mjs",
    "test:dist:firefox": "node scripts/assert-dist.mjs --firefox",
    "test:dist:all": "run-s test:dist test:dist:firefox",
    "commitlint": "commitlint --edit",
    "lint": "eslint src --ext .ts,.js,.tsx,.jsx",
    "lint:fix": "pnpm lint --fix",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "prettier": "prettier . --write",
    "prepare": "husky install",
    "release:github:dry": "node scripts/github-release.mjs --dry-run",
    "release:github": "node scripts/github-release.mjs --publish --commit --push",
    "release:github:full": "node scripts/github-release.mjs --full"
  },
  "type": "module",
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "devtools",
    "anti-debug"
  ],
  "author": "webLiang",
  "dependencies": {
    "construct-style-sheets-polyfill": "3.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "webextension-polyfill": "0.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.4",
    "@commitlint/config-conventional": "18.1.0",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-typescript": "11.1.5",
    "@testing-library/react": "14.0.0",
    "@types/chrome": "0.0.251",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.18",
    "@types/ws": "8.5.8",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "chokidar": "3.5.3",
    "cross-env": "7.0.3",
    "crx3": "^1.1.3",
    "esbuild": "~0.19.5",
    "eslint": "8.56.0",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "fs-extra": "11.1.1",
    "husky": "8.0.3",
    "jsdom": "^22.1.0",
    "lint-staged": "15.2.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.1.0",
    "rollup": "^4.62.0",
    "sass": "^1.85.0",
    "ts-loader": "9.5.0",
    "tslib": "2.6.2",
    "typescript": "5.7.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^8.4.0",
    "ws": "8.14.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.13.1"
}
